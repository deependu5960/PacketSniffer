{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PacketSniffer",
  "version": "0.2.0",
  "identifier": "DeependuMistri.PacketSniffer",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PacketSniffer",
        "width": 1000,
        "height": 600,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Deependu Mistri",
    "resources": {
      "../../backend/dist/PacketSnifferBackend/": "backend/"
    },
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
